APPL_NAME "EU NUTS3"
TERR_EXTENT (-31.828785,27.575987,79.290016,70.98973)
FULL_EXTENT (-63.151188,-21.388847,55.83578,80.83402)
USER_UNIT "degree"
HAS_GEO_COORD +

SHOW_LEGEND +
SHOW_LEGEND_SIZE 30
SHOW_LEGEND_TERRNAME +
SHOW_LEGEND_BGCOLOR +
SHOW_LEGEND_SCALE +
SHOW_LEGEND_NOBJECTS +
SHOW_RECORD_PERSISTENT -
SHOW_RECORD_TOOLTIP +
SHOW_MANIPULATOR +
SHOW_MANIPULATOR_SIZE 30
APPL_BGCOLOR (192,192,192)

LAYER "NUTS3.shp" "NUTS3.shp"
OBJECT_INFO "NUTS3.dbf"
FIELD_NAMES_IN_ROW 1
ID_FIELD 1
TYPE AREA
DRAWING +
HOLES_DRAWING -
ALLOW_SPATIAL_FILTER +
TRANSPARENCY 40
LABEL_TRANSPARENCY 40
SYMBOL_TRANSPARENCY 40
BORDERS +
BORDERW 1
HLIGHTEDW 3
SELECTEDW 3
BORDERCOLOR (82,82,82)
BACKGROUND  (161,193,230)
HATCH_STYLE 1

TABLEDATA "nuts3_population.csv" "nuts3_population.csv"
DELIMITER ","
FIELD_NAMES_IN_ROW 1
ID_FIELD "ID_NUTS3"
NAME_FIELD "Name"
LAYER_REF "NUTS3.shp"
